---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StepText from '../../components/StepText.astro';
import { getRecipeBySlug } from '../../lib/recipes';

const { slug } = Astro.params;
const recipe = getRecipeBySlug(slug);
if (!recipe) return new Response(null, { status: 404 });

const isExternalImage = recipe.image?.startsWith('http');
const imageSrc = recipe.image
  ? isExternalImage ? recipe.image : `/${recipe.image}`
  : null;

const hasIngredients = recipe.sidebarIngredients.length > 0;
const hasSections = recipe.sections.some((s) => s.content.length > 0);

function decimalsOf(value: number): number {
  const str = String(value);
  const dot = str.indexOf('.');
  return dot === -1 ? 0 : str.length - dot - 1;
}

const servingsNum = recipe.servings !== undefined && /^\d+(\.\d+)?$/.test(recipe.servings.trim())
  ? parseFloat(recipe.servings)
  : null;
---

<BaseLayout title={recipe.title} image={imageSrc ?? undefined} back="/" section="ricette">

  {imageSrc && (
    <div class="hero">
      <img src={imageSrc} alt={recipe.title} />
    </div>
  )}

  <div class="recipe-wrap">

    <header class="recipe-header">
      <div class="recipe-labels">
        {recipe.tags.map((tag) => (
          <a href={`/tag/${encodeURIComponent(tag)}`} class="label label-link">{tag}</a>
        ))}
      </div>
      <h1 class="recipe-title">{recipe.title}</h1>
      <div class="recipe-meta-row">
        {recipe.servings && (
          <span class="meta-chip">
            <span class="meta-key">Porzioni</span>
            <span class="meta-val">
              {servingsNum !== null ? (
                <input
                  type="text"
                  inputmode="decimal"
                  class="servings-input scalable"
                  data-base={servingsNum}
                  data-decimals={decimalsOf(servingsNum)}
                  value={servingsNum.toFixed(decimalsOf(servingsNum))}
                  aria-label="Numero di porzioni"
                />
              ) : recipe.servings}
            </span>
          </span>
        )}
        {recipe.source && (
          <span class="meta-chip">
            <span class="meta-key">Fonte</span>
            <span class="meta-val">
              {recipe.source.startsWith('http')
                ? <a href={recipe.source} target="_blank" rel="noopener">Link ↗</a>
                : recipe.source}
            </span>
          </span>
        )}
        <button id="cooking-toggle" type="button" class="cooking-toggle" aria-pressed="false" hidden>
          <svg class="cooking-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          <span class="cooking-toggle-label">Inizia a cucinare</span>
        </button>
      </div>
    </header>

    <div class="recipe-body">

      {hasIngredients && (
        <aside class="ingredients-panel">
          <div class="panel-header">
            <span class="panel-title">Ingredienti</span>
            <button type="button" id="reset-quantities" class="reset-btn">Ripristina dosi originali</button>
          </div>

          <ul class="ingredient-list">
            {recipe.sidebarIngredients.map((ing, i) => {
              const isNumeric = typeof ing.quantity === 'number';
              const decimals = isNumeric ? decimalsOf(ing.quantity as number) : 0;
              return (
                <li class="ingredient-item">
                  {isNumeric ? (
                    <span class="ing-qty-group">
                      <input
                        type="text"
                        inputmode="decimal"
                        class="ing-qty-input scalable"
                        data-base={ing.quantity as number}
                        data-decimals={decimals}
                        value={(ing.quantity as number).toFixed(decimals)}
                        aria-label={`Quantità di ${ing.name}`}
                      />
                      {ing.unit && <span class="ing-unit">{ing.unit}</span>}
                    </span>
                  ) : (
                    ing.displayText && <span class="ing-qty">{ing.displayText}</span>
                  )}
                  <label class="ing-check-row check-row">
                    <input type="checkbox" class="ing-check" id={`ing-${i}`} />
                    <span class="ing-name">{ing.name}</span>
                  </label>
                </li>
              );
            })}
          </ul>
        </aside>
      )}

      {hasSections && (
        <div class="steps-panel">
          {recipe.sections.map((section) => (
            section.content.length > 0 && (
              <section class="recipe-section">
                {section.title && (
                  <h3 class="section-title">{section.title}</h3>
                )}
                <div class="section-content">
                  {section.content.map((item) => {
                    if (item.type === 'note') {
                      return <p class="step-note">{item.text}</p>;
                    }
                    return (
                      <div class="step-item">
                        <span class="step-num" aria-hidden="true">{item.step.number}</span>
                        <StepText
                          step={item.step}
                          ingredients={recipe.ingredients}
                          cookwares={recipe.cookwares}
                          timers={recipe.timers}
                          inlineQuantities={recipe.inlineQuantities}
                        />
                      </div>
                    );
                  })}
                </div>
              </section>
            )
          ))}
        </div>
      )}

    </div>
  </div>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    width: 100%;
    height: clamp(240px, 45vw, 520px);
    overflow: hidden;
    background: var(--color-surface-alt);
    border-bottom: 1px solid var(--color-border);
  }
  .hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Wrapper ── */
  .recipe-wrap {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
  }

  /* ── Cooking mode toggle: the primary action, styled with real accent presence ── */
  .cooking-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--color-accent-dk);
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
    border: 1.5px solid var(--color-accent);
    border-radius: 999px;
    padding: 0.6em 1.1em;
    cursor: pointer;
    transition: border-color 0.12s, color 0.12s, background 0.12s, transform 0.12s;
    flex-shrink: 0;
    margin-left: auto;
    align-self: center;
  }
  .cooking-toggle[hidden] { display: none; }
  .cooking-toggle:hover {
    background: color-mix(in srgb, var(--color-accent) 18%, var(--color-surface));
  }
  .cooking-toggle:active { transform: scale(0.97); }
  .cooking-toggle-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
  .cooking-toggle.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-surface);
  }
  @media (max-width: 480px) {
    .cooking-toggle { flex: 1 1 100%; margin-left: 0; }
  }

  /* ── Header ── */
  .recipe-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .recipe-labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.875rem;
  }

  .label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-muted);
    background: var(--color-surface-alt);
    padding: 0.2em 0.6em;
    border-radius: var(--radius-sm);
  }
  .label-link:hover {
    background: var(--color-accent);
    color: #fff;
  }

  .recipe-title {
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .recipe-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .meta-chip {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .meta-key {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .meta-val {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .meta-val a { color: var(--color-accent); }

  /* ── Two-column layout ── */
  .recipe-body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .recipe-body {
      flex-direction: row;
      align-items: flex-start;
      gap: 0;
    }
  }

  /* ── Ingredients ── */
  .ingredients-panel {
    flex: 0 0 220px;
  }

  @media (min-width: 768px) {
    .ingredients-panel {
      position: sticky;
      top: 7rem;
      border-right: 1px solid var(--color-border);
      padding-right: 2rem;
      margin-right: 2.5rem;
    }
  }

  .panel-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-border-strong);
    margin-bottom: 1rem;
  }

  .panel-title {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .reset-btn {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--color-accent);
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .reset-btn:hover { color: var(--color-accent-dk); }

  /* ── Ingredient list ── */
  .ingredient-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  /* Grid, not flex: a long ingredient name must wrap inside a column of guaranteed
     width, never fall back to its own unwrapped content width and push onto a new
     line below the quantity. Flex's content-based flex-basis was doing exactly that. */
  .ingredient-item {
    display: grid;
    grid-template-columns: minmax(3.5rem, auto) 1fr;
    align-items: baseline;
    gap: 0.3rem 0.6rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .ing-check-row {
    min-width: 0;
    min-height: 2.5rem;
    gap: 0;
    padding: 0.2rem 0;
    border-radius: var(--radius-sm);
    transition: background 0.12s ease;
  }
  .ing-check-row:hover { background: var(--color-surface-alt); }
  .ing-check-row:has(:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  .ing-check {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .ingredient-item:has(.ing-check:checked) .ing-name {
    opacity: 0.3;
    text-decoration: line-through;
  }
  .ingredient-item:has(.ing-check:checked) .ing-qty,
  .ingredient-item:has(.ing-check:checked) .ing-qty-group {
    opacity: 0.3;
  }

  .ing-qty {
    display: inline-block;
    font-weight: 700;
    color: var(--color-text);
    white-space: nowrap;
  }
  .ing-name {
    color: var(--color-muted);
    cursor: pointer;
    transition: opacity 0.15s;
  }

  .ing-qty-group {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    white-space: nowrap;
    transition: opacity 0.15s;
  }

  .ing-qty-input {
    width: 4rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-accent) 7%, var(--color-surface));
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    padding: 0.1em 0.4em;
    text-align: right;
  }
  .ing-qty-input:hover { border-color: var(--color-accent-dk); }
  .ing-qty-input:focus {
    border-color: var(--color-accent-dk);
    background: var(--color-bg);
  }
  .ing-qty-input[aria-invalid="true"] {
    border-color: var(--color-accent-dk);
    border-width: 2px;
  }

  .ing-unit {
    font-weight: 700;
    color: var(--color-text);
  }

  .servings-input {
    width: 2.5rem;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    color: inherit;
    background: color-mix(in srgb, var(--color-accent) 7%, var(--color-surface));
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    padding: 0 0.3em;
    text-align: center;
  }
  .servings-input:hover { border-color: var(--color-accent-dk); }
  .servings-input:focus {
    border-color: var(--color-accent-dk);
    background: var(--color-surface);
  }
  .servings-input[aria-invalid="true"] {
    border-color: var(--color-accent-dk);
    border-width: 2px;
  }

  /* ── Steps ── */
  .steps-panel { flex: 1; min-width: 0; }

  .recipe-section { margin-bottom: 2.5rem; }

  .section-title {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .section-content {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .step-item {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .step-item:first-child { border-top: 1px solid var(--color-border); }

  .step-num {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    line-height: 1.75;
    text-align: right;
  }
  .hero { height: clamp(230px, 45vw, 540px); border-bottom: 0; }
  .recipe-wrap { padding-inline: clamp(1rem, 4vw, 3rem); padding-top: 1.5rem; }
  .cooking-toggle { min-height: 2.75rem; }
  .recipe-header { padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
  .recipe-labels { gap: .5rem; margin-bottom: .85rem; }
  .label { font-size: .72rem; letter-spacing: .01em; text-transform: none; border-radius: 999px; padding: .35em .85em; }
  .label-link:hover { color: var(--color-surface); }
  .recipe-title { max-width: 20ch; font-family: var(--font-serif); font-size: clamp(2.1rem, 8vw, 6rem); font-weight: 600; letter-spacing: -.03em; line-height: 1.08; margin-bottom: 1rem; }
  .meta-key, .panel-title, .section-title { letter-spacing: .04em; }
  .recipe-body { gap: 2rem; }
  .ingredients-panel { flex-basis: 300px; padding: 1.1rem 1.1rem 1.25rem; background: var(--color-surface); border-radius: var(--radius-md); }
  @media (min-width: 768px) { .ingredients-panel { top: 1.5rem; margin-right: 3rem; padding: 1.5rem; border: 0; } }
  .panel-header { border-bottom: 1px solid var(--color-border); }
  .panel-title { font-family: var(--font-serif); font-size: 1.35rem; font-weight: 600; text-transform: none; letter-spacing: -.02em; }
  .ingredient-item { padding: .6rem 0; font-size: .92rem; }
  .ing-qty-input { min-height: 2.5rem; font-size: .9rem; }
  .servings-input { min-height: 1.75rem; }
  .section-title { font-family: var(--font-serif); font-size: clamp(1.4rem, 5vw, 2.5rem); font-weight: 600; text-transform: none; letter-spacing: -.02em; color: var(--color-text); }
  .step-item { grid-template-columns: 1.6rem minmax(0, 1fr); gap: .65rem; padding: .85rem 0; }
  .step-num { width: 1.6rem; height: 1.6rem; display: grid; place-items: center; border-radius: 50%; background: var(--color-tag-bg); color: var(--color-tag-text); font-size: .68rem; text-align: center; line-height: 1; }
  @media (min-width: 768px) {
    .step-item { grid-template-columns: 2.5rem minmax(0, 1fr); gap: .75rem; padding: 1.25rem 0; }
    .step-num { width: 2rem; height: 2rem; font-size: .8rem; }
    .panel-title { font-size: 1.7rem; }
  }
  @media (max-width: 767px) { .recipe-header { margin-bottom: 1.5rem; } .recipe-body { gap: 2.5rem; } }
</style>

<script>
  const key = `checked:${window.location.pathname}`;
  const checks = document.querySelectorAll<HTMLInputElement>('.ing-check');
  const saved: string[] = JSON.parse(sessionStorage.getItem(key) ?? '[]');
  checks.forEach((el, i) => {
    if (saved.includes(String(i))) el.checked = true;
    el.addEventListener('change', () => {
      const active = [...checks]
        .map((c, idx) => (c.checked ? String(idx) : null))
        .filter(Boolean) as string[];
      sessionStorage.setItem(key, JSON.stringify(active));
    });
  });

  const scaleEls = document.querySelectorAll<HTMLInputElement>('.scalable');

  function roundTo(value: number, decimals: number): number {
    const factor = 10 ** decimals;
    return Math.round(value * factor) / factor;
  }

  function rescale(ratio: number, exceptEl: HTMLInputElement) {
    scaleEls.forEach((el) => {
      if (el === exceptEl) return;
      const base = parseFloat(el.dataset.base!);
      const decimals = parseInt(el.dataset.decimals ?? '0', 10);
      el.value = roundTo(base * ratio, decimals).toFixed(decimals);
      el.removeAttribute('aria-invalid');
    });
  }

  scaleEls.forEach((input) => {
    input.addEventListener('input', () => {
      const value = parseFloat(input.value);
      const base = parseFloat(input.dataset.base!);
      if (!isFinite(value) || value <= 0 || !isFinite(base) || base <= 0) {
        input.setAttribute('aria-invalid', 'true');
        return;
      }
      input.removeAttribute('aria-invalid');
      rescale(value / base, input);
    });
  });

  document.getElementById('reset-quantities')?.addEventListener('click', () => {
    scaleEls.forEach((el) => {
      const base = parseFloat(el.dataset.base!);
      const decimals = parseInt(el.dataset.decimals ?? '0', 10);
      el.value = base.toFixed(decimals);
      el.removeAttribute('aria-invalid');
    });
  });

  const cookingToggle = document.getElementById('cooking-toggle') as HTMLButtonElement | null;
  const cookingLabel = cookingToggle?.querySelector<HTMLElement>('.cooking-toggle-label');

  if (cookingToggle && 'wakeLock' in navigator) {
    cookingToggle.hidden = false;

    let sentinel: WakeLockSentinel | null = null;
    let cookingModeOn = false;

    function setToggleState(on: boolean) {
      cookingModeOn = on;
      cookingToggle!.classList.toggle('active', on);
      cookingToggle!.setAttribute('aria-pressed', String(on));
      if (cookingLabel) cookingLabel.textContent = on ? 'Cucinando' : 'Inizia a cucinare';
    }

    async function acquireWakeLock() {
      try {
        sentinel = await navigator.wakeLock.request('screen');
        sentinel.addEventListener('release', () => {
          sentinel = null;
        });
      } catch {
        setToggleState(false);
      }
    }

    cookingToggle.addEventListener('click', async () => {
      if (cookingModeOn) {
        setToggleState(false);
        const held = sentinel;
        sentinel = null;
        await held?.release();
      } else {
        setToggleState(true);
        await acquireWakeLock();
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (cookingModeOn && document.visibilityState === 'visible' && !sentinel) {
        acquireWakeLock();
      }
    });
  }
</script>
