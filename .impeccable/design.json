  "components": [
    {
      "name": "Recipe Search",
      "kind": "input",
      "refersTo": "search-input",
      "description": "Large touch-friendly search field.",
      "html": "<input class=\"ds-search\" type=\"search\" placeholder=\"Cerca una ricetta, un ingrediente…\" aria-label=\"Cerca ricette\">",
      "css": ".ds-search{width:100%;min-height:3.5rem;padding:.8rem 1.2rem;border:1px solid var(--color-border-strong);border-radius:var(--radius-md);background:var(--color-surface);color:var(--color-text);font:1rem \"DM Sans\",system-ui,sans-serif}.ds-search:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}"
    },
    {
      "name": "Filter Chip",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Rounded menu control for recipe filters.",
      "html": "<button class=\"ds-filter\">Ingredienti ▾</button>",
      "css": ".ds-filter{padding:.55rem .9rem;border:1px solid var(--color-border);border-radius:999px;background:var(--color-surface);color:var(--color-text);font:600 .8rem \"DM Sans\",system-ui,sans-serif;cursor:pointer}.ds-filter:hover,.ds-filter:focus-visible{border-color:var(--color-accent);outline-color:var(--color-accent)}"
    },
    {
      "name": "Recipe Card",
      "kind": "card",
      "refersTo": "recipe-card",
      "description": "Photo-led card with serif recipe title.",
      "html": "<a class=\"ds-card\" href=\"#\"><div class=\"ds-photo\">Ricetta</div><div class=\"ds-card-body\"><small>Essiccatore · Snack</small><strong>Barrette di cereali con frutta secca</strong></div></a>",
      "css": ".ds-card{display:block;overflow:hidden;border-radius:var(--radius-md);background:var(--color-surface);color:var(--color-text);text-decoration:none;box-shadow:0 1px 2px #21160b12,0 8px 22px #21160b0a;transition:transform .2s ease,box-shadow .2s ease}.ds-card:hover{transform:translateY(-3px);box-shadow:0 5px 12px #21160b16,0 18px 36px #21160b10}.ds-card:focus-visible{outline:2px solid var(--color-accent);outline-offset:3px}.ds-photo{aspect-ratio:4/3;display:grid;place-items:center;background:var(--color-surface-alt);color:var(--color-muted)}.ds-card-body{display:grid;gap:.5rem;padding:1rem 1rem 1.25rem}.ds-card-body small{font:600 .72rem \"DM Sans\",system-ui,sans-serif;color:var(--color-muted)}.ds-card-body strong{font:600 1.5rem/1.18 Literata,Georgia,serif;letter-spacing:-.025em}"
    },
    {
      "name": "Site Navigation",
      "kind": "nav",
      "description": "Simple cookbook wordmark with theme control.",
      "html": "<nav class=\"ds-nav\"><a href=\"#\">Le mie ricette</a><button aria-label=\"Cambia tema\">◐</button></nav>",
      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-between;padding:1rem 1.5rem;border-bottom:1px solid var(--color-border);background:var(--color-bg)}.ds-nav a{font:700 1.5rem Literata,Georgia,serif;letter-spacing:-.03em;color:var(--color-text);text-decoration:none}.ds-nav a:hover,.ds-nav a:focus-visible{color:var(--color-accent)}.ds-nav button{width:2.5rem;height:2.5rem;border:1px solid var(--color-border);border-radius:50%;background:var(--color-surface);color:var(--color-text)}"
    },
    {
      "name": "Serving Choice",
      "kind": "button",
      "description": "Circular serving multiplier control.",
      "html": "<button class=\"ds-serving\">2×</button>",
      "css": ".ds-serving{min-width:2.25rem;min-height:2.25rem;border:1px solid var(--color-border);border-radius:999px;background:transparent;color:var(--color-text);font:700 .78rem \"DM Sans\",system-ui,sans-serif;cursor:pointer}.ds-serving:hover,.ds-serving:focus-visible{border-color:var(--color-accent);color:var(--color-accent)}"
